// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    // 1. Current value ko 1 se increment karo
    Inc16(in=prevOut, out=incOut);

    // 2. Select: agar inc == 1 hai toh incOut lo, warna purani value (prevOut) lo
    Mux16(a=prevOut, b=incOut, sel=inc, out=w1);

    // 3. Select: agar load == 1 hai toh input 'in' lo, warna w1 lo
    Mux16(a=w1, b=in, sel=load, out=w2);

    // 4. Select: agar reset == 1 hai toh 0 (false) lo, warna w2 lo
    Mux16(a=w2, b=false, sel=reset, out=w3);

    // 5. Register mein value store karo (load=true taaki har clock cycle mein update ho sake)
    Register(in=w3, load=true, out=prevOut, out=out);
}